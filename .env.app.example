# Tenant-app prod env. Скопировать в .env.app и заполнить.
# Phase 7 deployment.

# --- Database -----------------------------------------------------------------
# Под `tenant_app` ролью (NOBYPASSRLS), через pgbouncer transaction-pool.
DATABASE_URL=postgresql+asyncpg://tenant_app:CHANGE_ME@autoworks-pgbouncer:6432/autoworks_tx

# Под `migrator_app` ролью (BYPASSRLS), через pgbouncer session-pool.
DATABASE_URL_MIGRATOR=postgresql+psycopg2://migrator_app:CHANGE_ME@autoworks-pgbouncer:6432/autoworks_session

# --- JWT (общий с platform-api) -----------------------------------------------
# Должен совпадать с PLATFORM_SECRET_KEY в autoservice-platform/.env.
SECRET_KEY=CHANGE_ME_GENERATE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- YooKassa (если используется приём оплаты от клиентов автосервиса) --------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Внешние интеграции (необязательно) ---------------------------------------
GIBDD_API_URL=
GIBDD_API_KEY=
PARTS_SUPPLIER_API_URL=
PARTS_SUPPLIER_API_KEY=

# --- SMTP (необязательно) -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Misc ---------------------------------------------------------------------
APP_BASE_URL=https://app.auto-works.pro
ENVIRONMENT=production
DEBUG=false
