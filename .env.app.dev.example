# DEV tenant-app (app-dev.auto-works.pro). Overlay поверх docker-compose.app.yml.
# На сервере: cp .env.app.dev.example .env.app.dev  и заполнить секреты.
# Запуск:
#   docker compose --env-file .env.app.dev -f docker-compose.app.yml up -d --build
#
# ⚠️ SECRET_KEY ДОЛЖЕН совпадать с PLATFORM_SECRET_KEY из dev-платформы
#    (/root/dev/autoservice-platform/.env.dev) — токен выпускает platform,
#    tenant-app валидирует тем же секретом.
# ⚠️ Пароли ролей — из /root/dev/autoservice-platform/.env.shared-db.dev.

# --- Идентификаторы dev-инстанса (изоляция от прода на том же VPS) ---
# basename каталога dev-клона (/root/dev/autoservice-manage) совпадает с прод —
# поэтому имя проекта задаём явно.
COMPOSE_PROJECT_NAME=autoservice-manage-dev
SHARED_DB_NETWORK=sharedb-dev_default
TENANT_APP_CONTAINER=autoworks-tenant-app-dev
TENANT_FRONTEND_CONTAINER=autoworks-tenant-frontend-dev
TENANT_APP_PORT=8102
TENANT_FRONTEND_PORT=8104

# --- БД: dev-pgbouncer (внутри сети порт 6432) ---
DATABASE_URL=postgresql+asyncpg://tenant_app:CHANGE_ME_TENANT_APP_DEV@autoworks-pgbouncer-dev:6432/autoworks_tx
DATABASE_URL_MIGRATOR=postgresql+psycopg2://migrator_app:CHANGE_ME_MIGRATOR_APP_DEV@autoworks-pgbouncer-dev:6432/autoworks_session

# --- JWT (общий с dev-платформой) ---
SECRET_KEY=CHANGE_ME_SAME_AS_PLATFORM_DEV_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Сессии ---
SESSION_LIMIT_ENABLED=true
SESSION_IDLE_MINUTES=30
DEFAULT_MAX_SESSIONS=1

# --- YooKassa (dev — тестовый магазин) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Внешние интеграции (dev — обычно пусто) ---
GIBDD_API_URL=
GIBDD_API_KEY=
PARTS_SUPPLIER_API_URL=
PARTS_SUPPLIER_API_KEY=

# --- SMTP (dev — обычно пусто) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Misc ---
APP_BASE_URL=https://app-dev.auto-works.pro
ENVIRONMENT=dev
DEBUG=true
